# Supabase (shared menu for live site)
# Dashboard: Project Settings → API Keys
#   - Publishable key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - Copy service API key (LEGACY) → SUPABASE_SERVICE_ROLE_KEY (JWT, starts with eyJ...)
#   - Do not use sb_secret_ for SUPABASE_SERVICE_ROLE_KEY with this app yet
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_jwt

# Must match admin login password (or set a separate secret)
ADMIN_API_SECRET=chandhu@123

# Razorpay (UPI QR payments) — Dashboard → API Keys + Webhooks
# Webhook URL: https://YOUR_DOMAIN/api/payments/webhook
# Enable event: qr_code.credited (and optionally payment.captured)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
